# Copy to .env and fill in your keys.
# Groq: https://console.groq.com/
# ElevenLabs: https://elevenlabs.io/ (Profile → API Key)
# Deepgram: https://developers.deepgram.com/

GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ElevenLabs voice_id (e.g. Rachel = 21m00Tcm4TlvDq8ikWAM)
# ELEVENLABS_VOICE=21m00Tcm4TlvDq8ikWAM

# Redis for conversation memory (optional; if missing, no history is kept)
REDIS_URL=redis://localhost:6379/0

# Deepgram model (e.g. nova-2)
# DEEPGRAM_MODEL=nova-2
